# Backend Environment Variables

# Django API Configuration
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# QLVB PostgreSQL source (set DB_ENGINE=postgresql to enable SQL-backed RAG)
DB_ENGINE=sqlite
DB_NAME=qlvb_tlbm
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Read-only database credentials for AI Chatbox SQL queries (Khuyến nghị môi trường Production)
# Sử dụng tài khoản CSDL chỉ đọc giúp loại trừ hoàn toàn nguy cơ sửa đổi dữ liệu và rò rỉ
DB_READONLY_USER=qlvb_readonly
DB_READONLY_PASSWORD=your_secure_readonly_password
DB_READONLY_NAME=qlvb_tlbm
DB_READONLY_HOST=127.0.0.1
DB_READONLY_PORT=5432

# Absolute root containing the paths/keys stored in SQL file_dinh_kem
QLVB_STORAGE_ROOT=./data/docs


# AI Provider Configuration (gemini or openai)
MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
EMBED_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-3.8-flash
VISION_MODEL=gemini-3.8-flash

# ChromaDB Configuration
CHROMA_DB_PATH=./data/chroma_db

# RAG Configuration
SIMILARITY_TOP_K=6
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# Vision OCR tuning (lower = faster)
VISION_OCR_MODE=fallback
VISION_OCR_PDF_DPI=150
VISION_OCR_MAX_IMAGE_SIZE=1024
VISION_OCR_JPEG_QUALITY=90
VISION_OCR_PARALLEL_WORKERS=3

# Email SMTP (thông báo trình ký). Điền tài khoản/mật khẩu thật trong backend/.env, không commit.
# Để trống EMAIL_HOST_USER hoặc EMAIL_HOST_PASSWORD thì email chỉ in ra console.
EMAIL_HOST=mail.baohiembaolong.vn
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Địa chỉ frontend để dựng đường dẫn trong email
FRONTEND_URL=http://localhost:5173

# Mật khẩu chung của 5 tài khoản demo (lệnh tao_tai_khoan_demo). Không commit giá trị thật.
DEMO_PASSWORD=
