# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (Mặc định: sqlite3 | Nếu dùng PostgreSQL: postgresql)
DB_ENGINE=sqlite3
DB_NAME=qlvb_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# SMTP birthday emails (leave blank until credentials are configured securely)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Branding used by birthday email templates
BRAND_NAME=Bảo Long Insurance
ORGANIZATION_NAME=Bảo Long Insurance

# Frontend API
VITE_API_BASE_URL=http://127.0.0.1:8000/api
