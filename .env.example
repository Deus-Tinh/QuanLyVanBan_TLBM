# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend API
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Email birthday delivery. Copy to .env or export these variables in the
# process environment. Replace placeholders with the approved SMTP provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=birthday@example.invalid

# Birthdays use Gregorian dates. In non-leap years, 29 February is observed on 28 February.
BIRTHDAY_LEAP_DAY_STRATEGY=FEB_28
